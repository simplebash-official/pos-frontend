{
  "name": "simplebash-pos",
  "private": true,
  "version": "1.4.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build:wasm": "if command -v wasm-pack >/dev/null 2>&1; then wasm-pack build --target web --out-dir ../../../frontend/src/wasm/pos-calc ../backend/crates/pos-calc-wasm --release && rm -f src/wasm/pos-calc/.gitignore; else echo 'wasm-pack not found, using pre-built wasm artifacts'; fi",
    "build:wasm:dev": "if command -v wasm-pack >/dev/null 2>&1; then wasm-pack build --target web --out-dir ../../../frontend/src/wasm/pos-calc ../backend/crates/pos-calc-wasm --dev && rm -f src/wasm/pos-calc/.gitignore; else echo 'wasm-pack not found, using pre-built wasm artifacts'; fi",
    "predev": "npm run build:wasm:dev",
    "prebuild": "npm run build:wasm",
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.sw.json && vite build",
    "build:tauri": "cross-env TAURI=true tsc && cross-env TAURI=true vite build --mode tauri",
    "preview": "vite preview",
    "format": "prettier --write .",
    "lint": "eslint .",
    "type-check": "tsc --noEmit && tsc -p tsconfig.sw.json",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:jest": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:all": "vitest run && NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "vitest",
    "generate:icons": "node scripts/generate-icon-shards.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "glob": "^13.0.6",
    "globals": "^17.8.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.23",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-morph": "^28.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  },
  "dependencies": {
    "@mantine/charts": "9.5.0",
    "@mantine/core": "^9.5.0",
    "@mantine/dates": "^9.5.0",
    "@mantine/form": "^9.5.0",
    "@mantine/hooks": "^9.5.0",
    "@mantine/modals": "^9.5.0",
    "@mantine/notifications": "^9.5.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@tabler/icons-react": "^3.45.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "axios": "^1.18.1",
    "dayjs": "^1.11.21",
    "dexie": "^4.4.4",
    "framer-motion": "^14.2.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5"
  }
}
