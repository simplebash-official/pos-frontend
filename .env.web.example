# ==============================================================================
# SimpleBash POS - Web Client Environment Configuration Example
# ==============================================================================
# Copy to .env or .env.production when building or deploying the web client:
#   cp .env.web.example .env
# ==============================================================================

# Relative path for reverse-proxy deployment (Nginx routes /api to backend:8080)
# Or set to full URL (e.g. https://pos.yourdomain.com/api) if hosted separately
VITE_API_BASE_URL=/api
VITE_APP_NAME="SimpleBash POS"

# Set to true when this web client talks to a multi-tenant cloud backend
# (TENANT_MODE=multi): the login then asks for the shop code. Leave unset for a single shop.
# VITE_MULTI_TENANT=true
# Where the multi-tenant login sends people without a shop (the SimpleBash app).
# VITE_ACCOUNTS_URL=https://app.simplebash.com
