# ==============================================================================
# jana2u-pos: Frontend Client Environment Configuration Example
# ==============================================================================
# Copy this file to .env (or .env.production for release builds):
#   cp .env.example .env
# Note: Vite only exposes variables prefixed with VITE_ to the browser bundle.
# ==============================================================================

# ==============================================================================
# 1. BACKEND API CONNECTION
# ==============================================================================
# Base URL for the Rust/Axum REST API endpoints.
# For local development, this typically points to http://localhost:8080/api.
# For production builds, set this to your publicly accessible backend domain.
VITE_API_BASE_URL=http://localhost:8080/api

# ==============================================================================
# 2. APPLICATION BRANDING & METADATA
# ==============================================================================
# Application display title used in browser tabs, navigation bars, and headers.
VITE_APP_NAME=Jana2U POS
